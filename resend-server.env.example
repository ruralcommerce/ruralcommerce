# Copie para resend-server.env (na raiz do projeto), preencha e NÃO faça commit.
# Enviar ao servidor: npm run push:resend-env

RESEND_API_KEY=re_sua_chave_aqui
RESEND_FROM_EMAIL=form@ruralcommerceglobal.com
CONTACT_TO_EMAIL=info@ruralcommerceglobal.com
PROJETO_INSCRIPTION_NOTIFY_EMAILS=operations@ruralcommerceglobal.com,tiagorezende@ruralcommerceglobal.com,pablogonzalez@ruralcommerceglobal.com

# URL base usada nos links de e-mail (convênio, admin). Sem barra final.
PROJETO_SITE_URL=https://ruralcommerceglobal.com

# WhatsApp Cloud API (Utility only — comunicações do projeto)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_UTILITY_TEMPLATE_NAME=projeto_atualizacao
WHATSAPP_UTILITY_TEMPLATE_LANG=es
# Código país para normalizar telefones sem + (Costa Rica)
WHATSAPP_DEFAULT_COUNTRY_CODE=+506

# Push web — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@ruralcommerceglobal.com
